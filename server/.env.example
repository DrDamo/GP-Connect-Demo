# NHS England Terminology Server — system-to-system credentials
# Request form: https://digital.nhs.uk/services/terminology-server/system-to-system-account-request-form
NHS_CLIENT_ID=your_client_id_here
NHS_CLIENT_SECRET=your_client_secret_here

# FHIR endpoint — Production 1 (analytical) is suitable for search/lookup use
# Production 2 (clinical) requires a separate agreement with NHS England
NHS_FHIR_BASE=https://ontology.nhs.uk/production1/fhir

# OAuth2 token endpoint (do not change)
NHS_TOKEN_URL=https://ontology.nhs.uk/authorisation/auth/realms/nhs-digital-terminology/protocol/openid-connect/token

# Port for this proxy server
PORT=3001
