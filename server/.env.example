# GP Connect Demonstrator backend — copy to server/.env for local development.
# In the container these come from the compose service; see docs/deployment-vps.md.

# --- Database ---------------------------------------------------------------
# The owner role. The database also needs the gpc_app role (see the docs).
DATABASE_URL=postgres://gpc:gpc@localhost:5432/gpc

# --- Public address ---------------------------------------------------------
# Links in emails, the Origin check on writes, and Secure cookies (https only).
# Defaults to http://localhost:5173 outside production.
# PUBLIC_URL=https://gpc.drdamo.me.uk

# --- NHS England Terminology Server -----------------------------------------
# Request form: https://digital.nhs.uk/services/terminology-server/system-to-system-account-request-form
NHS_CLIENT_ID=your_client_id_here
NHS_CLIENT_SECRET=your_client_secret_here
# Production 1 (analytical) is suitable for search/lookup use.
NHS_FHIR_BASE=https://ontology.nhs.uk/production1/fhir
NHS_TOKEN_URL=https://ontology.nhs.uk/authorisation/auth/realms/nhs-digital-terminology/protocol/openid-connect/token

# --- Email (signup confirmation) --------------------------------------------
# Without SMTP_HOST, signup is turned off in production; in development the
# confirmation link is printed to the server log instead.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Server -----------------------------------------------------------------
PORT=3001
# Loopback by default. The container uses 0.0.0.0 so Caddy can reach it.
HOST=127.0.0.1
# Browser origins allowed to call the API cross-origin (comma-separated).
# Not needed when the frontend and /api share an origin (production, and
# development through Vite's proxy).
CORS_ORIGINS=
# Reverse-proxy hops to trust for the client IP and HTTPS (1 behind Caddy).
TRUST_PROXY=0
# Sessions last this many days from last use.
SESSION_DAYS=7

# Per-IP limit for /api/snomed and /api/dmd.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Sign-in attempts per account per 15 minutes (per IP: twice this).
LOGIN_RATE_MAX=10
