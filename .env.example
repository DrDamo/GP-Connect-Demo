# ---------------------------------------------------------------------------
# GP Connect Demo — environment variables
# Copy to `.env.local` for local development. Never commit real values.
#
# Anything prefixed VITE_ is inlined into the browser bundle by Vite and is
# therefore PUBLIC. Only the Supabase anon (publishable) key belongs there.
# ---------------------------------------------------------------------------

# --- Frontend (public, shipped to the browser) ------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Optional: base path when hosting under a sub-path (e.g. GitHub Pages).
# Leave unset for Vercel.
# VITE_BASE_URL=/GP-Connect-Demo/

# --- Vercel serverless functions (api/) — server-side only -------------------
# NHS England Terminology Server system-to-system credentials.
# Request form: https://digital.nhs.uk/services/terminology-server/system-to-system-account-request-form
NHS_CLIENT_ID=your_client_id_here
NHS_CLIENT_SECRET=your_client_secret_here
# Production 1 (analytical) is suitable for search/lookup use.
NHS_FHIR_BASE=https://ontology.nhs.uk/production1/fhir
NHS_TOKEN_URL=https://ontology.nhs.uk/authorisation/auth/realms/nhs-digital-terminology/protocol/openid-connect/token

# Only needed by api/account/setup.ts and scripts/*.mjs (admin provisioning).
# The service-role key bypasses Row Level Security — never expose it with a
# VITE_ prefix and never paste it into the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SETUP_TOKEN=a-long-random-string-used-once-to-guard-api-account-setup
# Password for the seeded DrDamo demo admin account. Required by
# api/account/setup.ts and scripts/setup-user.mjs / repair-auth-user.mjs —
# never hardcode it in those files again. Re-running repair-auth-user.mjs
# with a new value here also rotates the existing account's password
# (no email delivery involved, so the account's .local address is fine).
SETUP_ADMIN_PASSWORD=set-a-new-strong-password-here

# --- Local Express proxy (server/) ----------------------------------------
# server/ reads server/.env (see server/.env.example); it uses the same
# NHS_* variables above plus:
# PORT=3001
